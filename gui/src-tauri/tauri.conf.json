{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arka",
  "version": "2.1.4",
  "identifier": "com.arka.dj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gist.githubusercontent.com/jesusguzmanjs/7b02aa1e30ac4b3a9daf82ccc554af19/raw/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NjVFMjREMkI2QzI1QjQKUldTMEpXd3JUZUpsTkxVZy9sQjhLdjFkUVdBYXd6aUYwSlo1ZmxMNmNBWWs2NUZvT1FEdmJNQ0UK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Arka",
        "width": 1120,
        "height": 970,
        "minWidth": 1024,
        "minHeight": 970,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/cuegrid-core/**/*"
      ],
      "macOS": {
        "infoPlist": "Info.plist"
      }
    }
}
